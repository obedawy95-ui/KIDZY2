    "PostVisitLog": {
      "title": "PostVisitLog",
      "description": "30-second post-visit field log submitted by mascot staff immediately after each visit.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "timestamp": { "type": "string", "format": "date-time", "maxLength": 64 },
        "createdAt": { "type": "string", "format": "date-time" },
        "childAgeGroup": { "type": "string", "maxLength": 64 },
        "actualDurationMinutes": { "type": "number" },
        "requestedExtraTime": { "type": "boolean" },
        "extraTimeNotes": { "type": "string", "maxLength": 2000 },
        "topMomQuestion": { "type": "string", "maxLength": 1000 },
        "pricingSentiment": { "type": "string", "maxLength": 100 },
        "missedOpportunities": { "type": "array" },
        "atmosphereRating": { "type": "number" },
        "characterName": { "type": "string", "maxLength": 128 },
        "staffNameOrCode": { "type": "string", "maxLength": 128 }
      },
      "required": [
        "id",
        "timestamp",
        "createdAt",
        "childAgeGroup",
        "actualDurationMinutes",
        "requestedExtraTime",
        "extraTimeNotes",
        "topMomQuestion",
        "pricingSentiment",
        "missedOpportunities",
        "atmosphereRating",
        "characterName",
        "staffNameOrCode"
      ]
    },
