      "title": "MediaCampaignSnapshot",
      "description": "Paid media or e-commerce store performance snapshot record, pruned after 90 days on 6-month cycles.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "platform": { "type": "string", "enum": ["meta", "snapchat", "tiktok", "google_ads", "kidzy_store"] },
        "accountId": { "type": "string", "maxLength": 128 },
        "campaignName": { "type": "string", "maxLength": 200 },
        "date": { "type": "string", "maxLength": 32 },
