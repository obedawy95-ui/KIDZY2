    "MediaRetentionLog": {
      "title": "MediaRetentionLog",
      "description": "Immutable audit record of 3-month data pruning runs executed on 6-month cycles.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
