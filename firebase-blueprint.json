    "MediaAdAccount": {
      "title": "MediaAdAccount",
      "description": "Connected paid media ad account or Kidzy e-commerce store configuration.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
