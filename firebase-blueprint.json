  "firestore": {
    "/post_visit_logs/{logId}": {
      "schema": { "$ref": "#/entities/PostVisitLog" },
      "description": "Real-time collection of 30-second post-visit field logs."
    },
    "/staff_surveys/{surveyId}": {
      "schema": { "$ref": "#/entities/StaffSurveyResponse" },
      "description": "Real-time collection of mascot character staff comprehensive surveys."
    },
    "/mother_surveys/{surveyId}": {
      "schema": { "$ref": "#/entities/MotherSurveyResponse" },
      "description": "Real-time collection of mother feedback surveys."
    },
    "/driver_surveys/{surveyId}": {
      "schema": { "$ref": "#/entities/DriverSurveyResponse" },
      "description": "Real-time collection of delivery driver surveys."
    },
    "/cs_surveys/{surveyId}": {
      "schema": { "$ref": "#/entities/CustomerServiceSurveyResponse" },
      "description": "Real-time collection of customer service team surveys."
    },
    "/ops_surveys/{surveyId}": {
      "schema": { "$ref": "#/entities/OperationsSurveyResponse" },
      "description": "Real-time collection of operations & dispatch surveys."
    },
    "/admins/{userId}": {
      "schema": { "$ref": "#/entities/AdminUser" },
      "description": "Authorized Kidzy dashboard administrators."
    },
    "/media_accounts/{accountId}": {
      "schema": { "$ref": "#/entities/MediaAdAccount" },
      "description": "Connected paid media ad accounts and Kidzy store config."
    },
    "/media_snapshots/{snapshotId}": {
      "schema": { "$ref": "#/entities/MediaCampaignSnapshot" },
      "description": "Paid media and store KPI snapshots with 3-month/6-month retention pruning."
    },
    "/media_retention_logs/{logId}": {
      "schema": { "$ref": "#/entities/MediaRetentionLog" },
      "description": "Audit trail of automatic/manual 3-month retention cleanups."
    },
    "/ux_property_audits/{auditId}": {
      "schema": { "$ref": "#/entities/UxPropertyAudit" },
      "description": "Live inspection audits for kidzy.qa web, iOS App Store, and Google Play."
    }
  }
